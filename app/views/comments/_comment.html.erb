<div id="<%= dom_id comment %>">
  <div>
    <strong>Body:</strong>
    <%= comment.body %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= comment.user.email %>
  </div>

  <div>
    <strong>Created:</strong>
    <%= tag.time comment.created_at.strftime("%Y-%m-%d %H:%M %Z"), datetime: comment.created_at.iso8601 %>
  </div>

</div>
